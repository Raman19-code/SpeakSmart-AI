# Copy to .env and fill in. Never commit .env.

# --- Server (private; never exposed to the browser) ---
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Vapi ---
# Public key from the Vapi dashboard (public keys are designed for browser use).
# The server hands it to the client; it is NOT prefixed with VITE_.
VAPI_PUBLIC_KEY=your_vapi_public_key_here
# Voice used by the assistant (see Vapi docs for valid provider/voice pairs).
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
# Language model Vapi uses during the live call (billed via your Vapi account setup).
VAPI_LLM_MODEL=gpt-4o-mini
